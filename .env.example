# Copy to .env.local (local dev) or .env.production.local and fill in.
# `npm run setup` generates a ready-to-use .env.local for local development.

# Frontend (exposed to the browser): only VITE_* values. Never put secrets here.
VITE_CHAIN=anvil                 # anvil | robinhoodTestnet | robinhood
VITE_RPC_URL=                    # optional RPC override for the browser

# API server (never exposed to the browser)
CHAIN=anvil
SIWE_DOMAIN=localhost:5173       # host the game is served from
SERVER_SIGNER_KEY=               # 0x… private key that signs score attestations
SESSION_SECRET=                  # random string, at least 32 characters
DATA_FILE=.data/store.json       # where replays, daily boards and pilot names are kept
RPC_URL=                         # optional RPC override for the server
TRUST_PROXY=                     # 1 only behind a proxy that overwrites X-Forwarded-For (for per-IP limits)
